@model TrainTicketWeb.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<div class="stats-grid">
    <div class="stat-card"><div class="value">@Model.TotalRevenue.ToString("N0") ₫</div><div class="label">Tổng doanh thu</div></div>
    <div class="stat-card success"><div class="value">@Model.RevenueLast30.ToString("N0") ₫</div><div class="label">Doanh thu 30 ngày</div></div>
    <div class="stat-card accent"><div class="value">@Model.TotalBookings</div><div class="label">Đơn đặt vé</div></div>
    <div class="stat-card"><div class="value">@Model.TotalTickets</div><div class="label">Vé đã bán</div></div>
    <div class="stat-card"><div class="value">@Model.TotalCustomers</div><div class="label">Khách hàng</div></div>
    <div class="stat-card"><div class="value">@Model.TotalTrips</div><div class="label">Chuyến tàu</div></div>
    <div class="stat-card accent"><div class="value">@Model.PendingRefunds</div><div class="label">Yêu cầu hoàn tiền</div></div>
</div>

<div class="card">
    <h2>Doanh thu 14 ngày gần nhất</h2>
    @if (Model.RevenueByDay.Count == 0)
    {
        <p class="text-muted">Chưa có dữ liệu thanh toán.</p>
    }
    else
    {
        var maxDay = Model.RevenueByDay.Max(x => x.value);
        <div class="bar-chart">
            @foreach (var d in Model.RevenueByDay)
            {
                var h = maxDay <= 0 ? 0 : (int)Math.Round(d.value / maxDay * 140);
                <div class="bar-item">
                    <div class="bar-value">@d.value.ToString("N0")</div>
                    <div class="bar" style="height:@(h)px"></div>
                    <div class="bar-label">@d.label</div>
                </div>
            }
        </div>
    }
</div>

<div class="grid-2">
    <div class="card">
        <h2>Doanh thu theo tuyến</h2>
        @if (Model.RevenueByRoute.Count == 0)
        {
            <p class="text-muted">Chưa có dữ liệu.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Tuyến</th><th class="text-right">Doanh thu</th></tr></thead>
                <tbody>
                @foreach (var r in Model.RevenueByRoute)
                {
                    <tr><td>@r.label</td><td class="text-right">@r.value.ToString("N0") ₫</td></tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2>Tỷ lệ lấp đầy chuyến</h2>
        @if (Model.OccupancyByTrip.Count == 0)
        {
            <p class="text-muted">Chưa có dữ liệu.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Chuyến</th><th class="text-right">Lấp đầy</th></tr></thead>
                <tbody>
                @foreach (var o in Model.OccupancyByTrip)
                {
                    <tr><td>@o.label</td><td class="text-right">@o.percent%</td></tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
