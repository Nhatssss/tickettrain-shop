@model TrainTicketWeb.ViewModels.RouteDetailViewModel
@{
    ViewData["Title"] = "Cấu hình tuyến";
    var route = Model.Route;
}

@if (route == null)
{
    <div class="alert alert-error">Không tìm thấy tuyến.</div>
    <a href="@Url.Action("Routes", "Route", new { area = "Admin" })" class="btn btn-outline">Quay lại</a>
}
else
{
    <div class="card">
        <h2>@route.RouteName</h2>
        <form asp-action="SaveRoute" asp-controller="Route" asp-area="Admin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@route.RouteId" />
            <div class="form-row">
                <div class="form-group"><label>Tên tuyến</label><input type="text" name="route_name" class="form-control" value="@route.RouteName" required /></div>
                <div class="form-group">
                    <label>Ga đầu</label>
                    <select name="start_station_id" class="form-control">
                        @foreach (var s in Model.AllStations)
                        {
                            <option value="@s.StationId" selected="@(s.StationId == route.StartStationId)">@s.StationName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Ga cuối</label>
                    <select name="end_station_id" class="form-control">
                        @foreach (var s in Model.AllStations)
                        {
                            <option value="@s.StationId" selected="@(s.StationId == route.EndStationId)">@s.StationName</option>
                        }
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Cập nhật tuyến</button>
        </form>
    </div>

    <div class="card">
        <h2>Danh sách ga trên tuyến (theo thứ tự + khoảng cách km)</h2>
        <form asp-action="SaveRouteStations" asp-controller="Route" asp-area="Admin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="route_id" value="@route.RouteId" />
            <table class="table">
                <thead><tr><th>Thứ tự</th><th>Ga</th><th>Khoảng cách từ ga đầu (km)</th></tr></thead>
                <tbody>
                @foreach (var s in Model.AllStations)
                {
                    var existing = Model.RouteStations.FirstOrDefault(x => x.StationId == s.StationId);
                    var dist = existing?.DistanceKm ?? 0;
                    <tr>
                        <td>
                            @if (existing != null)
                            {
                                <span class="badge badge-primary">@existing.StopOrder</span>
                            }
                        </td>
                        <td>
                            <input type="checkbox" name="station_id" value="@s.StationId" checked="@(existing != null)" />
                            @s.StationName
                        </td>
                        <td><input type="number" step="0.1" name="distance_km" value="@dist" class="form-control" style="max-width:180px;" /></td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="text-muted">Thứ tự ga được lấy theo thứ tự chọn từ trên xuống (ga đầu → ga cuối).</p>
            <button type="submit" class="btn btn-accent">Lưu danh sách ga</button>
        </form>
    </div>
}
