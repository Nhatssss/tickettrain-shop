@model List<TrainTicketWeb.Models.Booking>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="card">
    <h2>Lọc theo trạng thái</h2>
    <form asp-action="Bookings" asp-area="Admin" asp-controller="Booking" method="get">
        <div class="form-row">
            <div class="form-group">
                <select name="status" class="form-control" style="max-width:220px;">
                    <option value="">Tất cả</option>
                    <option value="holding">Đang giữ chỗ</option>
                    <option value="paid">Đã thanh toán</option>
                    <option value="expired">Hết hạn</option>
                    <option value="cancelled">Đã hủy</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Lọc</button>
        </div>
    </form>
</div>

<div class="card">
    <h2>Danh sách đơn</h2>
    <table class="table">
        <thead><tr><th>Mã đơn</th><th>Khách</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            var cls = b.Status switch
            {
                "paid" => "badge-success",
                "holding" => "badge-warning",
                "expired" => "badge-muted",
                "cancelled" => "badge-accent",
                _ => "badge-muted"
            };
            var label = b.Status switch
            {
                "paid" => "Đã thanh toán",
                "holding" => "Đang giữ chỗ",
                "expired" => "Hết hạn",
                "cancelled" => "Đã hủy",
                _ => b.Status
            };
            <tr>
                <td><strong>@b.BookingCode</strong></td>
                <td>@b.ContactEmail</td>
                <td>@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="price">@b.TotalAmount.ToString("N0") ₫</td>
                <td><span class="badge @cls">@label</span></td>
                <td><a href="@Url.Action("BookingDetail", "Booking", new { area = "Admin", bookingId = b.BookingId })" class="btn btn-primary btn-sm">Xem</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
