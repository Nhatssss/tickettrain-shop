@model List<TrainTicketWeb.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
    var keyword = (string)(ViewBag.Keyword ?? "");
}

<div class="card">
    <h2>Tìm kiếm người dùng</h2>
    <form asp-action="Users" asp-controller="QuanTri" method="get">
        <div class="form-row">
            <div class="form-group">
                <label>Từ khóa</label>
                <input type="text" name="keyword" value="@keyword" class="form-control"
                       placeholder="Họ tên, email hoặc SĐT" style="max-width:300px;" />
            </div>
            <button type="submit" class="btn btn-primary">Tìm</button>
            <a href="@Url.Action("Users", "QuanTri")" class="btn btn-light">Xóa lọc</a>
            <a href="@Url.Action("ExportUsers", "QuanTri", new { keyword })" class="btn btn-success">Xuất CSV</a>
        </div>
    </form>
    <p class="text-muted" style="margin-top:8px;">
        Tìm thấy <strong>@Model.Count</strong> người dùng@(string.IsNullOrWhiteSpace(keyword) ? "" : $" khớp \"{keyword}\"").
    </p>
</div>

<div class="card">
    <h2>Danh sách người dùng</h2>
    @if (Model.Count == 0)
    {
        <p class="text-muted">Không có người dùng nào khớp điều kiện tìm kiếm.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.Phone</td>
                    <td><span class="badge @(u.Role == "admin" ? "badge-accent" : "badge-primary")">@u.Role</span></td>
                    <td><span class="badge @(u.Status == "active" ? "badge-success" : "badge-muted")">@u.Status</span></td>
                    <td>
                        @if (u.Role != "admin")
                        {
                            <form asp-action="SetUserStatus" asp-controller="QuanTri" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserId" />
                                @if (u.Status == "active")
                                {
                                    <button type="submit" name="status" value="locked" class="btn btn-accent btn-sm">Khóa</button>
                                }
                                else
                                {
                                    <button type="submit" name="status" value="active" class="btn btn-success btn-sm">Mở khóa</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>