@model List<TrainTicketWeb.Models.Fare>
@{
    ViewData["Title"] = "Quản lý giá vé";
    var stations = (List<TrainTicketWeb.Models.Station>)ViewBag.Stations;
    var coachTypes = (List<TrainTicketWeb.Models.CoachType>)ViewBag.CoachTypes;
}

<div class="card">
    <h2>Thêm / sửa bảng giá</h2>
    <form asp-action="SaveFare" asp-controller="QuanTri" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="0" />
        <div class="form-row">
            <div class="form-group">
                <label>Ga đi</label>
                <select name="fromId" class="form-control">
                    @foreach (var s in stations) { <option value="@s.StationId">@s.StationName</option> }
                </select>
            </div>
            <div class="form-group">
                <label>Ga đến</label>
                <select name="toId" class="form-control">
                    @foreach (var s in stations) { <option value="@s.StationId">@s.StationName</option> }
                </select>
            </div>
            <div class="form-group">
                <label>Loại toa</label>
                <select name="coachTypeId" class="form-control">
                    @foreach (var c in coachTypes) { <option value="@c.CoachTypeId">@c.TypeName</option> }
                </select>
            </div>
            <div class="form-group"><label>Giá cơ bản (VNĐ)</label><input type="number" min="0" name="base_price" class="form-control" required /></div>
            <div class="form-group"><label>Hiệu lực từ</label><input type="date" name="effective_from" class="form-control" required /></div>
        </div>
        <button type="submit" class="btn btn-primary">Thêm giá</button>
    </form>
</div>

<div class="card">
    <h2>Bảng giá hiện tại</h2>
    <form asp-action="Fares" asp-controller="QuanTri" method="get" style="margin-bottom:14px;">
        <div class="form-row">
            <div class="form-group">
                <label>Tìm theo ga / loại toa</label>
                <input type="text" name="keyword" value="@(ViewBag.Keyword ?? "")" class="form-control"
                       placeholder="Hà Nội, Đà Nẵng, Ghế mềm..." style="max-width:300px;" />
            </div>
            <button type="submit" class="btn btn-primary">Tìm</button>
            <a href="@Url.Action("Fares", "QuanTri")" class="btn btn-light">Xóa lọc</a>
            <a href="@Url.Action("ExportFares", "QuanTri", new { keyword = ViewBag.Keyword })" class="btn btn-success">Xuất CSV</a>
        </div>
    </form>
    <p class="text-muted">Tìm thấy <strong>@Model.Count</strong> mức giá.</p>
    <table class="table">
        <thead><tr><th>Ga đi</th><th>Ga đến</th><th>Loại toa</th><th>Giá</th><th>Hiệu lực từ</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" style="text-align:center;color:#8a94a3;padding:24px;">Không có mức giá nào khớp.</td></tr>
        }
        @foreach (var f in Model)
        {
            <tr>
                <td>@stations.FirstOrDefault(s => s.StationId == f.FromStationId)?.StationName</td>
                <td>@stations.FirstOrDefault(s => s.StationId == f.ToStationId)?.StationName</td>
                <td>@coachTypes.FirstOrDefault(c => c.CoachTypeId == f.CoachTypeId)?.TypeName</td>
                <td class="price">@f.BasePrice.ToString("N0") ₫</td>
                <td>@f.EffectiveFrom.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
