@model List<TrainTicketWeb.Models.Booking>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var status = (string)(ViewBag.Status ?? "");
    var keyword = (string)(ViewBag.Keyword ?? "");
}

<div class="card">
    <h2>Tìm kiếm &amp; lọc</h2>
    <form asp-action="Bookings" asp-controller="QuanTri" method="get">
        <div class="form-row">
            <div class="form-group">
                <label>Từ khóa</label>
                <input type="text" name="keyword" value="@keyword" class="form-control"
                       placeholder="Mã đơn, email hoặc SĐT" style="max-width:280px;" />
            </div>
            <div class="form-group">
                <label>Trạng thái</label>
                <select name="status" class="form-control" style="max-width:220px;">
                    <option value="" selected="@(status == "")">Tất cả</option>
                    <option value="holding" selected="@(status == "holding")">Đang giữ chỗ</option>
                    <option value="paid" selected="@(status == "paid")">Đã thanh toán</option>
                    <option value="expired" selected="@(status == "expired")">Hết hạn</option>
                    <option value="cancelled" selected="@(status == "cancelled")">Đã hủy</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Tìm</button>
            <a href="@Url.Action("Bookings", "QuanTri")" class="btn btn-light">Xóa lọc</a>
            <a href="@Url.Action("ExportBookings", "QuanTri", new { status, keyword })" class="btn btn-success">Xuất CSV</a>
        </div>
    </form>
    <p class="text-muted" style="margin-top:8px;">
        Tìm thấy <strong>@Model.Count</strong> đơn@(string.IsNullOrWhiteSpace(keyword) ? "" : $" khớp \"{keyword}\"").
    </p>
</div>

<div class="card">
    <h2>Danh sách đơn</h2>
    @if (Model.Count == 0)
    {
        <p class="text-muted">Không có đơn nào khớp điều kiện tìm kiếm.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Mã đơn</th><th>Khách</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                var cls = b.Status switch
                {
                    "paid" => "badge-success",
                    "holding" => "badge-warning",
                    "expired" => "badge-muted",
                    "cancelled" => "badge-accent",
                    _ => "badge-muted"
                };
                var label = b.Status switch
                {
                    "paid" => "Đã thanh toán",
                    "holding" => "Đang giữ chỗ",
                    "expired" => "Hết hạn",
                    "cancelled" => "Đã hủy",
                    _ => b.Status
                };
                <tr>
                    <td><strong>@b.BookingCode</strong></td>
                    <td>@b.ContactEmail</td>
                    <td>@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="price">@b.TotalAmount.ToString("N0") ₫</td>
                    <td><span class="badge @cls">@label</span></td>
                    <td><a href="@Url.Action("BookingDetail", "QuanTri", new { bookingId = b.BookingId })" class="btn btn-primary btn-sm">Xem</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>