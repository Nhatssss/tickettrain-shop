@model TrainTicketWeb.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    var totalRev = Model.TotalRevenue;
    var maxDay = Model.RevenueByDay.Count == 0 ? 0m : Model.RevenueByDay.Max(x => x.value);
    var maxRoute = Model.RevenueByRoute.Count == 0 ? 0m : Model.RevenueByRoute.Max(x => x.value);
    var topOcc = Model.OccupancyByTrip.OrderByDescending(x => x.percent).Take(8).ToList();
    var avgOcc = topOcc.Count == 0 ? 0 : Math.Round(topOcc.Average(x => x.percent), 1);
}

<div class="dash">
    <div class="page-head">
        <div>
            <h1>Tổng quan hệ thống</h1>
            <p class="text-muted" style="margin:0">Cập nhật lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</p>
        </div>
        <div class="dash-head-actions">
            <a class="btn btn-sm btn-ghost" href="@Url.Action("Finance", "QuanTri")">Báo cáo tài chính</a>
            <a class="btn btn-sm btn-primary" href="@Url.Action("Trips", "QuanTri")">Quản lý chuyến</a>
        </div>
    </div>

    @* ===== 4 chỉ số chính ===== *@
    <div class="kpi-grid">
        <div class="kpi kpi-primary">
            <div class="kpi-icon">₫</div>
            <div class="kpi-body">
                <div class="kpi-label">Tổng doanh thu</div>
                <div class="kpi-value">@totalRev.ToString("N0")<span class="kpi-unit">đ</span></div>
            </div>
        </div>
        <div class="kpi kpi-success">
            <div class="kpi-icon">↗</div>
            <div class="kpi-body">
                <div class="kpi-label">Doanh thu 30 ngày</div>
                <div class="kpi-value">@Model.RevenueLast30.ToString("N0")<span class="kpi-unit">đ</span></div>
                <div class="kpi-sub">7 ngày: @Model.RevenueLast7.ToString("N0") đ</div>
            </div>
        </div>
        <div class="kpi kpi-warning">
            <div class="kpi-icon">📋</div>
            <div class="kpi-body">
                <div class="kpi-label">Đơn đặt vé</div>
                <div class="kpi-value">@Model.TotalBookings</div>
                <div class="kpi-sub">@Model.TotalTickets vé đã bán</div>
            </div>
        </div>
        <div class="kpi @(Model.PendingRefunds > 0 ? "kpi-accent" : "kpi-muted")">
            <div class="kpi-icon">⟲</div>
            <div class="kpi-body">
                <div class="kpi-label">Yêu cầu hoàn tiền</div>
                <div class="kpi-value">@Model.PendingRefunds</div>
                <div class="kpi-sub">@(Model.PendingRefunds > 0 ? "Cần xử lý" : "Không có tồn đọng")</div>
            </div>
        </div>
    </div>

    @* ===== Chỉ số phụ ===== *@
    <div class="mini-grid">
        <div class="mini"><span class="mini-k">Khách hàng</span><span class="mini-v">@Model.TotalCustomers</span></div>
        <div class="mini"><span class="mini-k">Chuyến tàu</span><span class="mini-v">@Model.TotalTrips</span></div>
        <div class="mini"><span class="mini-k">Vé / đơn</span><span class="mini-v">@(Model.TotalBookings == 0 ? "0" : Math.Round((double)Model.TotalTickets / Model.TotalBookings, 2).ToString("0.##"))</span></div>
        <div class="mini"><span class="mini-k">Lấp đầy TB</span><span class="mini-v">@avgOcc%</span></div>
        <div class="mini"><span class="mini-k">Doanh thu / đơn</span><span class="mini-v">@(Model.TotalBookings == 0 ? "0" : (totalRev / Model.TotalBookings).ToString("N0")) đ</span></div>
    </div>

    @* ===== Biểu đồ doanh thu ===== *@
    <section class="card dash-card">
        <div class="dash-card-head">
            <h2>Doanh thu 14 ngày gần nhất</h2>
            <span class="dash-card-meta">Cao nhất: @maxDay.ToString("N0") đ</span>
        </div>
        @if (Model.RevenueByDay.Count == 0)
        {
            <p class="text-muted">Chưa có dữ liệu thanh toán.</p>
        }
        else
        {
            <div class="chart">
                <div class="chart-axis">
                    <span>@maxDay.ToString("N0")</span>
                    <span>@((maxDay / 2).ToString("N0"))</span>
                    <span>0</span>
                </div>
                <div class="chart-plot">
                    <div class="chart-lines"><i></i><i></i><i></i></div>
                    <div class="chart-cols">
                        @foreach (var d in Model.RevenueByDay)
                        {
                            var pct = maxDay <= 0 ? 0 : (double)(d.value / maxDay) * 100;
                            var isTop = d.value == maxDay;
                            <div class="col" title="@d.label: @d.value.ToString("N0") đ">
                                <div class="col-val">@(d.value == 0 ? "" : d.value.ToString("N0"))</div>
                                <div class="col-track">
                                    <div class="col-bar @(isTop ? "is-top" : "")" style="height:@pct.ToString("0.#")%"></div>
                                </div>
                                <div class="col-label">@d.label</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </section>

    @* ===== Hai bảng co giãn ===== *@
    <div class="dash-split">
        <section class="card dash-card">
            <div class="dash-card-head">
                <h2>Doanh thu theo tuyến</h2>
                <span class="dash-card-meta">@Model.RevenueByRoute.Count tuyến</span>
            </div>
            @if (Model.RevenueByRoute.Count == 0)
            {
                <p class="text-muted">Chưa có dữ liệu.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-compact">
                        <thead><tr><th style="width:44%">Tuyến</th><th class="text-right" style="width:22%">Doanh thu</th><th style="width:34%">Tỷ trọng</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.RevenueByRoute)
                        {
                            var p = maxRoute <= 0 ? 0 : (double)(r.value / maxRoute) * 100;
                            <tr>
                                <td class="cell-strong">@r.label</td>
                                <td class="text-right nowrap">@r.value.ToString("N0") đ</td>
                                <td>
                                    <div class="prog"><div class="prog-fill is-primary" style="width:@p.ToString("0.#")%"></div></div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="card dash-card">
            <div class="dash-card-head">
                <h2>Tỷ lệ lấp đầy chuyến</h2>
                <span class="dash-card-meta">Top @topOcc.Count chuyến</span>
            </div>
            @if (topOcc.Count == 0)
            {
                <p class="text-muted">Chưa có dữ liệu.</p>
            }
            else
            {
                <div class="occ-list">
                    @foreach (var o in topOcc)
                    {
                        var cls = o.percent >= 80 ? "is-success" : (o.percent >= 40 ? "is-warning" : "is-primary");
                        <div class="occ-row">
                            <div class="occ-name">@o.label</div>
                            <div class="prog prog-lg"><div class="prog-fill @cls" style="width:@(Math.Min(o.percent,100).ToString("0.#"))%"></div></div>
                            <div class="occ-pct">@o.percent%</div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
