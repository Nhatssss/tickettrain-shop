@model TrainTicketWeb.ViewModels.SeatSelectViewModel
@{
    ViewData["Title"] = "Chọn chỗ";
}

<div class="card">
    <h2>Chọn chỗ — Tàu @Model.TrainCode</h2>
    <p class="text-muted">
        @Model.RouteName · @Model.DepartureDate.ToString("dd/MM/yyyy")
        · @Model.FromStationName → @Model.ToStationName
        · Cần chọn @Model.PassengerCount chỗ
    </p>
    <div class="legend">
        <span><span class="seat seat-free" style="cursor:default;">01</span> <strong>Còn trống</strong></span>
        <span><span class="seat seat-held" style="cursor:default;">02</span> <strong>Đang giữ chỗ</strong></span>
        <span><span class="seat seat-sold" style="cursor:default;">03</span> <strong>Đã bán</strong></span>
        <span><span class="seat seat-selected" style="cursor:default;">04</span> <strong>Đã chọn</strong></span>
    </div>

    <form asp-action="Hold" asp-controller="Booking" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tripId" value="@Model.TripId" />
        <input type="hidden" name="fromId" value="@Model.FromStationId" />
        <input type="hidden" name="toId" value="@Model.ToStationId" />
        <input type="hidden" name="leg" value="@Model.Leg" />
        <input type="hidden" name="passengerCount" value="@Model.PassengerCount" />

        @foreach (var coach in Model.Coaches)
        {
            <div class="coach-block">
                <h4>Toa @coach.CoachNumber <span style="color:#4A5361; font-weight:600;">— @coach.TypeName</span></h4>
                <div class="seats-grid">
                    @foreach (var seat in coach.Seats)
                    {
                        var cls = seat.Status == "free" ? "seat-free" : seat.Status == "held" ? "seat-held" : "seat-sold";
                        if (seat.Status == "free")
                        {
                            <label class="seat @cls" data-seat="@seat.SeatId">
                                <input type="checkbox" name="seatIds" value="@seat.SeatId" style="display:none;" class="seat-check" />
                                @seat.SeatNumber
                            </label>
                        }
                        else
                        {
                            <span class="seat @cls">@seat.SeatNumber</span>
                        }
                    }
                </div>
            </div>
        }

        <div class="flex-between mt-3">
            <span id="seat-counter" class="text-accent" style="font-weight:700;">Đã chọn: 0 / @Model.PassengerCount</span>
            <button type="submit" id="btn-hold" class="btn btn-accent" disabled>Giữ chỗ</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const checks = document.querySelectorAll('.seat-check');
    const max = @Model.PassengerCount;
    const counter = document.getElementById('seat-counter');
    const btn = document.getElementById('btn-hold');
    function update() {
        const n = document.querySelectorAll('.seat-check:checked').length;
        counter.textContent = 'Đã chọn: ' + n + ' / ' + max;
        btn.disabled = (n !== max);
        checks.forEach(c => {
            const label = c.closest('label');
            label.classList.toggle('seat-selected', c.checked);
            label.classList.toggle('seat-free', !c.checked);
        });
    }
    checks.forEach(c => c.addEventListener('change', () => {
        const n = document.querySelectorAll('.seat-check:checked').length;
        if (n > max) { c.checked = false; alert('Bạn chỉ cần chọn ' + max + ' chỗ.'); }
        update();
    }));
</script>
}
