@model TrainTicketWeb.ViewModels.BookingDetailViewModel
@{
    ViewData["Title"] = "Thanh toán";
    var subtotal = Model.Subtotal;
}

<div class="card">
    <h2>Thanh toán — @Model.Booking.BookingCode</h2>
    <div class="alert alert-warning">
        Thời gian giữ chỗ còn lại đến <strong>@Model.Booking.HoldExpiresAt.ToString("HH:mm:ss dd/MM/yyyy")</strong>.
        Vui lòng thanh toán trước khi hết hạn.
    </div>

    <h3>Chi tiết vé</h3>
    <table class="table">
        <thead><tr><th>Hành khách</th><th>Chuyến</th><th>Chỗ</th><th>Giá cuối</th></tr></thead>
        <tbody>
        @foreach (var t in Model.Tickets)
        {
            <tr>
                <td>@t.Ticket.PassengerName</td>
                <td>@t.TrainCode · @t.FromStationName → @t.ToStationName</td>
                <td>Toa @t.CoachNumber · Chỗ @t.SeatNumber</td>
                <td class="price">@t.Ticket.FinalPrice.ToString("N0") ₫</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="mt-3" style="border:1px solid #e3e7ee;border-radius:10px;padding:16px;background:#fbfcfe;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
            <label for="couponInput" style="font-weight:600;margin:0;">Mã giảm giá</label>
            <span style="color:#5b6472;font-size:0.9rem;">Nhập mã và bấm Áp dụng — số tiền sẽ cập nhật ngay.</span>
        </div>
        <div class="form-row mt-2" style="align-items:flex-end;">
            <div class="form-group" style="margin-bottom:0;">
                <input id="couponInput" type="text" class="form-control" placeholder="VD: GIFF555"
                       style="text-transform:uppercase;" autocomplete="off" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <button type="button" id="couponApply" class="btn btn-primary">Áp dụng</button>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <button type="button" id="couponClear" class="btn btn-light" style="display:none;">Bỏ mã</button>
            </div>
        </div>
        <div id="couponMsg" class="mt-1" style="font-size:0.92rem;min-height:1.3em;"></div>
    </div>

    <div class="mt-2">
        <div style="display:flex;justify-content:space-between;"><span>Tạm tính</span><span id="sumSubtotal">@subtotal.ToString("N0") ₫</span></div>
        <div style="display:flex;justify-content:space-between;color:#2E7D32;">
            <span>Giảm giá <span id="sumCode"></span></span>
            <span id="sumDiscount">−0 ₫</span>
        </div>
    </div>

    <div class="flex-between mt-2">
        <h3>Tổng tiền: <span class="price" id="sumTotal">@Model.Booking.TotalAmount.ToString("N0") ₫</span></h3>
    </div>

    <form asp-action="Pay" asp-controller="Booking" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="bookingId" value="@Model.Booking.BookingId" />
        <div class="form-row mt-2">
            <div class="form-group">
                <label>Phương thức thanh toán (mô phỏng)</label>
                <select name="method" class="form-control">
                    <option value="vnpay">VNPAY</option>
                    <option value="momo">MoMo</option>
                    <option value="bank_qr">Chuyển khoản QR</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-success" style="font-size:1.05rem;">Xác nhận thanh toán</button>
    </form>
</div>

<script>
(function () {
    var bookingId = @Model.Booking.BookingId;
    var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
    var token = tokenEl ? tokenEl.value : '';
    var input = document.getElementById('couponInput');
    var msg = document.getElementById('couponMsg');
    var btnApply = document.getElementById('couponApply');
    var btnClear = document.getElementById('couponClear');
    var applied = @(string.IsNullOrEmpty(Model.CouponCode) ? "null" : "'" + Model.CouponCode + "'");

    function money(v) { return Math.round(v).toLocaleString('vi-VN') + ' ₫'; }

    function paint(r) {
        document.getElementById('sumSubtotal').textContent = money(r.subtotal);
        document.getElementById('sumDiscount').textContent = '−' + money(r.discount);
        document.getElementById('sumTotal').textContent = money(r.total);
        document.getElementById('sumCode').textContent = r.code ? '(' + r.code + ')' : '';
    }

    function send(url, body) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: body
        }).then(function (x) { return x.json(); });
    }

    btnApply.addEventListener('click', function () {
        var code = (input.value || '').trim();
        if (!code) { msg.style.color = '#E53935'; msg.textContent = 'Vui lòng nhập mã giảm giá.'; return; }
        btnApply.disabled = true;
        send('@Url.Action("ApplyCoupon", "Booking")',
             'bookingId=' + bookingId + '&code=' + encodeURIComponent(code))
            .then(function (r) {
                btnApply.disabled = false;
                if (!r.ok) { msg.style.color = '#E53935'; msg.textContent = r.error; return; }
                applied = r.code;
                msg.style.color = '#2E7D32';
                msg.textContent = 'Đã áp mã ' + r.code + ' — giảm ' + money(r.discount) + '.';
                paint(r);
                btnClear.style.display = '';
            })
            .catch(function () { btnApply.disabled = false; msg.style.color = '#E53935'; msg.textContent = 'Không kết nối được máy chủ.'; });
    });

    btnClear.addEventListener('click', function () {
        send('@Url.Action("ClearCoupon", "Booking")', 'bookingId=' + bookingId)
            .then(function (r) {
                applied = null;
                input.value = '';
                msg.style.color = '#5b6472';
                msg.textContent = 'Đã bỏ mã giảm giá.';
                paint(r);
                btnClear.style.display = 'none';
            });
    });

    if (applied) {
        msg.style.color = '#2E7D32';
        msg.textContent = 'Đang áp mã ' + applied + '.';
        btnClear.style.display = '';
        input.value = applied;
    }
})();
</script>
