@model TrainTicketWeb.ViewModels.PassengersViewModel
@{
    ViewData["Title"] = "Thông tin hành khách";
}

<div class="card">
    <h2>Thông tin hành khách — @Model.BookingCode</h2>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form asp-action="Passengers" asp-controller="Booking" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="bookingId" value="@Model.BookingId" />

        <table class="table">
            <thead>
                <tr><th>Chuyến / Chỗ</th><th>Họ tên</th><th>Đối tượng</th><th>Giấy tờ</th><th>Giá gốc</th></tr>
            </thead>
            <tbody>
            @for (int i = 0; i < Model.Passengers.Count; i++)
            {
                var p = Model.Passengers[i];
                <tr>
                    <td>
                        <input type="hidden" name="ticketIds[@i]" value="@p.TicketId" />
                        <strong>@p.TripLabel</strong><br />
                        <span class="text-muted">@p.CoachSeat</span>
                    </td>
                    <td><input type="text" name="names[@i]" class="form-control" value="@p.PassengerName" required /></td>
                    <td>
                        <select name="passengerTypeIds[@i]" class="form-control">
                            @foreach (var pt in Model.PassengerTypes)
                            {
                                <option value="@pt.PassengerTypeId" selected="@(pt.PassengerTypeId == p.PassengerTypeId)">
                                    @pt.TypeName@(pt.DiscountPercent > 0 ? $" (-{pt.DiscountPercent}%)" : "")
                                </option>
                            }
                        </select>
                    </td>
                    <td><input type="text" name="idNumbers[@i]" class="form-control" value="@p.IdNumber" placeholder="CCCD/Mã SV (nếu có)" /></td>
                    <td class="price">@p.OriginalPrice.ToString("N0") ₫</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Tiếp tục thanh toán</button>
            <a href="@Url.Action("MyBookings", "Booking")" class="btn btn-outline">Hủy bỏ</a>
        </div>
    </form>
</div>
