@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="card" style="border-left:5px solid var(--color-accent);">
    <h2 style="color:var(--color-accent);">Đã xảy ra lỗi</h2>
    <p class="text-muted">
        Hệ thống không xử lý được yêu cầu của bạn. Vui lòng thử lại, hoặc quay về trang chủ.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted" style="font-size:.85rem;">
            Mã yêu cầu: <code>@Model.RequestId</code>
        </p>
    }

    <div style="margin-top:16px; display:flex; gap:10px; flex-wrap:wrap;">
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Về trang chủ</a>
        <a href="@Url.Action("Index", "Home")#tim-chuyen" class="btn btn-outline">Tìm chuyến khác</a>
    </div>
</div>
