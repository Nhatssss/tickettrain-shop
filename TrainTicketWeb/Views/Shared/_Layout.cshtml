<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Đặt Vé Tàu</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar">
        <a href="@Url.Action("Index", "Home")" class="brand">
            <span class="logo">VT</span>
            <span>Vé Tàu Hỏa</span>
        </a>
        <div class="nav-links">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("admin"))
                {
                    <a href="@Url.Action("Index", "QuanTri")">Quản trị</a>
                }
                else
                {
                    <a href="@Url.Action("MyBookings", "Booking")">Vé của tôi</a>

                    @* ===== Chuông thông báo ===== *@
                    <div class="notif-wrap" id="notifWrap">
                        <button type="button" class="notif-btn" id="notifBtn" title="Thông báo">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                            </svg>
                            <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                        </button>
                        <div class="notif-panel" id="notifPanel">
                            <div class="notif-head">
                                <strong>Thông báo</strong>
                                <button type="button" id="notifMarkAll">Đánh dấu đã đọc</button>
                            </div>
                            <div class="notif-list" id="notifList">
                                <div class="notif-empty">Đang tải…</div>
                            </div>
                        </div>
                    </div>
                }
                <a href="@Url.Action("Profile", "Account")">@User.Identity.Name</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-accent btn-sm">Đăng xuất</button>
                </form>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                <a href="@Url.Action("Register", "Account")">Đăng ký</a>
            }
        </div>
    </nav>

    <div class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @RenderBody()
    </div>

    <footer class="footer">
        Hệ thống bán vé tàu hỏa trực tuyến — Đồ án học tập
    </footer>

    @if (User.Identity.IsAuthenticated && !User.IsInRole("admin"))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
