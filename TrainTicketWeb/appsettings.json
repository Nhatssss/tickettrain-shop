{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TrainTicketDB": "Server=(LocalDB)\\MSSQLLocalDB;Database=TrainTicketDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "BusinessRules": {
    "HoldMinutes": 15,
    "CancellationPolicy": [
      { "hoursBefore": 72, "feePercent": 0 },
      { "hoursBefore": 24, "feePercent": 10 },
      { "hoursBefore": 6,  "feePercent": 20 },
      { "hoursBefore": 0,  "feePercent": 30 }
    ]
  }
}
